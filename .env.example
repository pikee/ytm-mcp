# Public HTTPS domain served by Caddy.
MCP_DOMAIN=ytm.example.com

# Generate three independent random secrets. Never reuse Yandex OAuth tokens here.
MCP_API_KEY=replace-with-random-secret-at-least-24-chars
MCP_OAUTH_CLIENT_ID=chatgpt-ytm
MCP_OAUTH_CLIENT_SECRET=replace-with-random-secret-at-least-24-chars
MCP_OAUTH_REDIRECT_URI=https://chatgpt.com/connector/oauth/replace-with-your-callback-id
MCP_OAUTH_SIGNING_KEY=replace-with-random-secret-at-least-32-chars

# Add one object per Yandex account. Only one account may be primary.
YTM_ACCOUNTS_JSON=[{"name":"owner","token":"replace-with-yandex-oauth-token","primary":true},{"name":"agency","token":"replace-with-second-yandex-oauth-token","primary":false}]

# Known Yandex Tag Manager container IDs, separated by commas.
YTM_CONTAINER_IDS=123456,789012

# Yandex API request and retry settings.
YTM_TIMEOUT_SECONDS=15
YTM_MAX_RETRIES=3
YTM_RETRY_BASE_DELAY=0.5

# MCP OAuth token lifetimes in seconds.
MCP_OAUTH_ACCESS_TOKEN_TTL=3600
MCP_OAUTH_REFRESH_TOKEN_TTL=2592000
